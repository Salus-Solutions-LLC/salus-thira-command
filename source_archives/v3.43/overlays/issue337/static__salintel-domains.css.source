.salintel-domain-hero{display:flex;justify-content:space-between;gap:32px;align-items:flex-start;padding:30px;border:1px solid #d9e2e8;border-left:4px solid var(--salus-blue);border-radius:var(--radius);background:#fff;margin-bottom:24px}.salintel-domain-hero h2{margin:7px 0;color:var(--salus-blue-strong)}.salintel-domain-hero p{max-width:760px;margin:0;color:#465d6d}.salintel-domain-metrics{display:grid;grid-template-columns:auto auto;gap:6px 12px;min-width:180px}.salintel-domain-metrics strong{font-size:1.35rem;color:var(--salus-blue);text-align:right}.salintel-domain-metrics span{color:#536773}.salintel-filters{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;align-items:end}.salintel-status-grid{display:grid;grid-template-columns:repeat(4,minmax(130px,1fr));gap:12px;margin:14px 0 24px}.salintel-status-grid div{border:1px solid #d9e2e8;background:#fff;padding:14px;border-radius:10px}.salintel-status-grid span{display:block;color:#60717b;font-size:.78rem;text-transform:uppercase;letter-spacing:.05em}.salintel-status-grid strong{display:block;margin-top:4px;color:#102f43}.salintel-lenses{display:flex;gap:6px;flex-wrap:wrap}.salintel-lenses span,.salintel-tier{display:inline-block;border:1px solid #b8cbd8;background:var(--salus-blue-soft);color:var(--salus-blue-strong);padding:3px 8px;margin:2px;border-radius:999px;font-size:.78rem}.salintel-controls{flex-wrap:wrap}.salintel-detail{margin-top:24px;padding-top:24px;border-top:2px solid var(--salus-blue)}.salintel-create summary,.salintel-registry summary{font-weight:700;color:var(--salus-blue);cursor:pointer}.salintel-registry-detail{margin-top:20px;padding-top:20px;border-top:1px solid #cad8e1}.salintel-registry-detail article{min-width:0}.salintel-registry-detail p{overflow-wrap:anywhere}.salintel-empty{text-align:center;padding:36px}.salintel-create .field-help{display:block;margin-top:6px;font-size:.8rem;color:#536773;font-weight:400}@media(max-width:760px){.salintel-domain-hero{display:block}.salintel-domain-metrics{margin-top:18px}.salintel-status-grid{grid-template-columns:repeat(2,1fr)}}@media print{.salintel-domain-hero{background:#fff;border-color:#555}.salintel-lenses span,.salintel-tier{background:#fff;border-color:#555;color:#111}.salintel-controls,.salintel-create{display:none!important}}
