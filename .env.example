# Salus THIRA Command v0.8 configuration template.
# Use operating-system/container secrets or Azure Key Vault in production. Do not commit real values.
SALUS_ENV=development
SALUS_AUTH_MODE=prototype
SALUS_COOKIE_SECURE=0
SALUS_SESSION_HOURS=12
SALUS_ALLOW_RESTORE=0
SALUS_SEED_DEMO=1
SALUS_ALLOW_SQLITE_PRODUCTION=0

# Secret provider: env | azure_keyvault
SALUS_SECRET_BACKEND=env
SALUS_KEY_VAULT_URL=
SALUS_OIDC_CLIENT_SECRET_KEYVAULT_NAME=
SALUS_POSTGRES_DSN_KEYVAULT_NAME=
SALUS_AZURE_STORAGE_CONNECTION_STRING_KEYVAULT_NAME=

# OIDC / Microsoft Entra. Production uses managed_identity and no client secret.
SALUS_OIDC_DISCOVERY_URL=
SALUS_OIDC_CLIENT_ID=
SALUS_OIDC_CLIENT_AUTH_METHOD=client_secret
SALUS_OIDC_CLIENT_SECRET=
SALUS_OIDC_TENANT_ID=
SALUS_OIDC_MANAGED_IDENTITY_CLIENT_ID=
SALUS_OIDC_REDIRECT_URI=
SALUS_OIDC_DEFAULT_TENANT_SLUG=salus-prototype
SALUS_OIDC_AUTO_PROVISION=0
SALUS_OIDC_SCOPES=openid profile email
SALUS_OIDC_PROVIDER_NAME=oidc

# Runtime database: sqlite | postgres
SALUS_DB_BACKEND=sqlite
SALUS_DB_PATH=./thira.db
# PostgreSQL auth: dsn | entra. DSN can be sourced from Key Vault through SALUS_POSTGRES_DSN.
SALUS_POSTGRES_AUTH=dsn
SALUS_DATABASE_URL=
SALUS_POSTGRES_DSN=
# For Microsoft Entra / managed-identity database auth:
SALUS_POSTGRES_HOST=
SALUS_POSTGRES_PORT=5432
SALUS_POSTGRES_DATABASE=
SALUS_POSTGRES_USER=
SALUS_POSTGRES_SSLMODE=require
# Optional reporting/transition label: none | postgresql | azure_postgresql
SALUS_MANAGED_DB_TARGET=none

# Evidence storage: local | azure
SALUS_STORAGE_BACKEND=local
SALUS_LOCAL_STORAGE_DIR=./attachments
# Preferred Azure production mode: account URL + DefaultAzureCredential / managed identity.
SALUS_AZURE_STORAGE_ACCOUNT_URL=
SALUS_AZURE_STORAGE_CONTAINER=salus-thira-evidence
# Connection string is supported as a fallback and can be sourced from Key Vault.
SALUS_AZURE_STORAGE_CONNECTION_STRING=

# Malware scanning
SALUS_AV_MODE=off
SALUS_REQUIRE_AV=0
SALUS_CLAMSCAN_PATH=clamscan
SALUS_RETENTION_DEFAULT_DAYS=2555

# Rate limiting
SALUS_RATE_LIMIT_ENABLED=1
SALUS_RATE_LIMIT_BACKEND=memory
SALUS_RATE_LIMIT_REQUESTS=240
SALUS_RATE_LIMIT_WINDOW_SECONDS=60
SALUS_REDIS_URL=

# Public Protection Advisor notifications: outbox | graph
# Graph mode uses the Azure user-assigned managed identity and an existing authorized mailbox.
SALUS_ADVISOR_NOTIFICATION_MODE=outbox
SALUS_ADVISOR_NOTIFICATION_FROM=mduncan@salus.solutions
SALUS_ADVISOR_NOTIFICATION_TO=mduncan@salus.solutions
SALUS_ADVISOR_REQUIRE_EMAIL_VERIFICATION=0

# Governed Microsoft 365 intake. The application receives read access only to
# this explicit folder; the managed identity supplies a federated assertion.
SALUS_M365_INTAKE_DRIVE_ID=
SALUS_M365_INTAKE_FOLDER_ITEM_ID=
SALUS_M365_INTAKE_MAX_FILE_BYTES=26214400

# Approved enterprise-knowledge destination. After destination upload and
# SHA-256 verification, the intake source is moved—not deleted—to the exact
# processed-intake archive folder.
SALUS_M365_KNOWLEDGE_DRIVE_ID=
SALUS_M365_KNOWLEDGE_FOLDER_ITEM_ID=
SALUS_M365_PROCESSED_INTAKE_FOLDER_ITEM_ID=

# Released Protected Member reports. Write access is granted only to this
# explicit SharePoint folder through Files.SelectedOperations.Selected.
SALUS_M365_REPORT_DRIVE_ID=
SALUS_M365_REPORT_FOLDER_ITEM_ID=
SALUS_M365_REPORT_MAX_FILE_BYTES=26214400
SALUS_M365_REPORT_RETRIES=3

# Security telemetry: json | azure_monitor
SALUS_TELEMETRY_BACKEND=json
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Discovery Conversations candidate: leave disabled until governed release.
SALUS_DISCOVERY_ENABLED=0
SALUS_DISCOVERY_STAFF_TENANT_ID=
SALUS_DISCOVERY_REVIEWER_IDS=
