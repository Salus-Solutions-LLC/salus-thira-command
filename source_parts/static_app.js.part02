
const configs={
assessments:{title:'Assessment',fields:[['name','Name','text',1],['organization','Organization','text',1],['assessment_type','Type','select',['Enterprise','Facility','Program','Event','Executive','Regional']],['status','Status','select',['Draft','Scope Approved','Evidence Collection','Analysis','SME Review','Salus QA','Client Validation','Findings Finalized','Executive Decisions','Implementation','Validation','Active Monitoring','Reassessment']],['purpose','Purpose','textarea',1],['mission','Mission','textarea',1],['scope','Scope','textarea',1],['exclusions','Exclusions','textarea',0],['executive_sponsor','Executive Sponsor','text',0],['assessment_director','Salus Assessment Director','text',0],['lead_assessor','Lead Assessor','text',0],['target_completion','Target Completion','date',0],['reassessment_date','Reassessment Date','date',0],['classification','Classification','select',['Standard','Restricted','Sensitive','Highly Sensitive']]],cols:['id','name','organization','assessment_type','status','scope_locked','version']},
threats:{title:'Threat / Hazard',fields:[['assessment_id','Assessment ID','number',1],['name','Name','text',1],['category','Category','select',['Natural','Public Health','Technological','Cyber','Physical Security','Human Threat','Insider','Terrorism','Civil Disturbance','Supply Chain','Utility','Transportation','Financial','Personnel','Executive Threat','Geopolitical','Operational']],['description','Description','textarea',0],['likelihood','Likelihood (1-5)','number',1],['vulnerability','Vulnerability (1-5)','number',1],['consequence','Consequence (1-5)','number',1],['confidence','Confidence','select',['Low','Medium','High']],['trend','Trend','select',['Increasing','Stable','Decreasing','Unknown']],['inclusion_status','Inclusion','select',['Included - Scenario Required','Included - Monitor Only','Screened Out','Deferred Pending Evidence']],['basis','Basis / Evidence','textarea',0]],cols:['id','assessment_id','name','category','likelihood','vulnerability','consequence','confidence','trend','inclusion_status']},
scenarios:{title:'Scenario',fields:[['assessment_id','Assessment ID','number',1],['threat_id','Threat ID','number',1],['title','Title','text',1],['narrative','Narrative','textarea',1],['initiating_event','Initiating Event','text',0],['location','Location','text',0],['duration','Duration','text',0],['operating_conditions','Operating Conditions','textarea',0],['dependencies','Dependencies','textarea',0],['decision_points','Decision Points','textarea',0],['assumptions','Assumptions','textarea',0],['uncertainties','Uncertainties','textarea',0],['life_safety','Life Safety (1-5)','number',1],['mission','Mission (1-5)','number',1],['operations','Operations (1-5)','number',1],['financial','Financial (1-5)','number',1],['legal_regulatory','Legal/Regulatory (1-5)','number',1],['reputation','Reputation (1-5)','number',1],['recovery','Recovery (1-5)','number',1],['evidence_confidence','Evidence Confidence','select',['Low','Medium','High']],['professional_override','Professional Override','text',0],['override_reason','Override Reason','textarea',0]],cols:['id','assessment_id','threat_id','title','duration','evidence_confidence','professional_override']},
capabilities:{title:'Capability',fields:[['assessment_id','Assessment ID','number',1],['scenario_id','Scenario ID','number',0],['name','Capability Name','text',1],['mission_area','Mission Area','text',0],['capability_family','Capability Family','text',0],['required_outcome','Required Outcome','textarea',1],['operating_conditions','Operating Conditions','textarea',0],['performance_metric','Performance Metric','text',0],['required_standard','Required Standard','number',1],['current_performance','Current Performance','number',1],['responsible_function','Responsible Function','text',0],['owner','Owner','text',0],['dependencies','Dependencies','textarea',0],['evidence_required','Evidence Required','textarea',0],['confidence','Confidence','select',['Low','Medium','High']],['last_validated','Last Validated','date',0],['next_validation','Next Validation','date',0]],cols:['id','assessment_id','scenario_id','name','required_standard','current_performance','confidence']},
evidence:{title:'Evidence',fields:[['assessment_id','Assessment ID','number',1],['capability_id','Capability ID','number',0],['scenario_id','Scenario ID','number',0],['title','Title','text',1],['evidence_type','Type','select',['Policy','Plan','SOP','Contract','Training Record','Exercise Result','Interview','Observation','Inspection','System Record','Performance Data','Incident History','Photograph','Video','Financial Record','External Study','Regulatory Requirement','Intelligence','SME Judgment']],['source','Source','text',0],['owner','Owner','text',0],['evidence_date','Evidence Date','date',0],['reliability','Reliability','select',['Low','Medium','High']],['verification_status','Verification','select',['Pending','Verified','Conflicting','Stale']],['sensitivity','Sensitivity','select',['Standard','Restricted','Sensitive','Highly Sensitive']],['notes','Notes','textarea',0]],cols:['id','assessment_id','title','evidence_type','reliability','verification_status','sensitivity']},
gaps:{title:'Gap',fields:[['assessment_id','Assessment ID','number',1],['capability_id','Capability ID','number',1],['gap_type','Gap Type','select',['People','Plans/Procedures','Policy/Governance','Training','Equipment','Technology','Facilities','Communications','Intelligence/Information','Logistics','Staffing','Contracts','Partnerships','Finance','Authority','Compliance','Continuity','Leadership/Decision Authority','Other']],['description','Description','textarea',1],['severity','Severity','select',['Low','Moderate','High','Critical']],['root_cause','Root Cause','textarea',0],['status','Status','select',['Open','Under Review','Mitigating','Closed']]],cols:['id','assessment_id','capability_id','gap_type','severity','status','description']},
improvements:{title:'Improvement',fields:[['assessment_id','Assessment ID','number',1],['gap_id','Gap ID','number',1],['title','Title','text',1],['description','Description','textarea',0],['initial_cost','Initial Cost','number',0],['recurring_cost','Recurring Cost','number',0],['implementation_days','Implementation Days','number',0],['feasibility','Feasibility (1-5)','number',1],['consequence_reduction','Consequence Reduction (1-5)','number',1],['mission_benefit','Mission Benefit (1-5)','number',1],['sustainability','Sustainability (1-5)','number',1],['compliance_impact','Compliance Impact (1-5)','number',1],['staffing_impact','Staffing Impact (1-5)','number',1],['expected_capability_gain','Expected Capability Gain (points)','number',0],['dependencies','Dependencies','textarea',0],['owner','Owner','text',0],['status','Status','select',['Proposed','Under Review','Approved','Funded','Underway','Complete','Decision Recorded']]],cols:['id','assessment_id','gap_id','title','initial_cost','implementation_days','priority_score','status']},
reassessment_triggers:{title:'Reassessment Trigger',fields:[['assessment_id','Assessment ID','number',1],['source','Source','select',['Manual','ThreatHub','Incident','Exercise','Leadership Change','Facility Change','Technology Change','Regulatory Change','Completed Improvement']],['trigger_type','Trigger Type','text',1],['description','Description','textarea',1],['severity','Severity','select',['Low','Moderate','High','Critical']],['affected_record_type','Affected Record Type','text',0],['affected_record_id','Affected Record ID','number',0],['status','Status','select',['Open','In Review','Resolved']],['assigned_to','Assigned To','text',0],['due_date','Due Date','date',0],['resolution','Resolution','textarea',0]],cols:['id','assessment_id','source','trigger_type','severity','status','assigned_to','due_date']},
decisions:{title:'Executive Decision',fields:[['assessment_id','Assessment ID','number',1],['improvement_id','Improvement ID','number',0],['decision_type','Decision','select',['Approve','Approve with Conditions','Modify','Defer','Reject','Transfer Risk','Accept Risk','Continue Monitoring']],['authority','Decision Authority','text',1],['rationale','Rationale','textarea',1],['funding_authorized','Funding Authorized','number',0],['conditions','Conditions','textarea',0],['implementation_owner','Implementation Owner','text',0],['target_completion','Target Completion','date',0],['expected_residual_risk','Expected Residual Risk','text',0],['review_date','Review Date','date',0]],cols:['id','assessment_id','improvement_id','decision_type','authority','funding_authorized','review_date']}
};

async function entityView(key){const c=configs[key]; if(key!=='assessments'&&!activeAssessmentId){const a=await getActiveAssessment();if(!a){$('#content').innerHTML='<div class="notice">Create an assessment first.</div>';return;}} const rows=await api(scopedUrl(key)); const edit=editingRecord&&editingRecord.key===key?rows.find(r=>r.id===editingRecord.id):null; const immutable=key==='decisions'; const defaults=edit||((key!=='assessments'&&activeAssessmentId)?{assessment_id:activeAssessmentId}:{}); $('#content').innerHTML=`<div class="split"><div class="card"><div class="section-title"><h2>${edit?'Edit':'New'} ${c.title}</h2>${edit?'<button class="btn secondary" type="button" onclick="cancelEdit()">Cancel</button>':''}</div>${immutable?'<div class="subtle" style="margin-bottom:10px">Executive decisions are append-only records. Corrections should be entered as a new superseding decision.</div>':''}<form id="entity-form">${formHtml(c.fields,defaults)}<div class="form-actions"><button class="btn">${edit?'Update':'Save'} ${c.title}</button></div></form></div><div><div class="section-title"><h2>${c.title} Register</h2><span class="subtle">${rows.length} records</span></div>${entityTable(key,c,rows)}</div></div>`; $('#entity-form').onsubmit=async e=>{e.preventDefault(); const data={}; new FormData(e.target).forEach((v,k)=>{if(v==='') return; const type=c.fields.find(f=>f[0]===k)?.[2]; data[k]=type==='number'?Number(v):v}); if(edit) await api(`/api/${key}/${edit.id}`,{method:'PUT',body:JSON.stringify(data)}); else {const created=await api('/api/'+key,{method:'POST',body:JSON.stringify(data)}); if(key==='assessments'){activeAssessmentId=created.id;localStorage.setItem('salus_assessment_id',String(created.id));await renderAssessmentSelector();}} editingRecord=null; render();};}
function formHtml(fields,record={}){return `<div class="form-grid">${fields.map(f=>{const [name,label,type,opt]=f; const wide=type==='textarea'?'wide':''; const val=record[name]??''; if(type==='select') return `<label class="${wide}">${label}<select name="${name}">${opt.map(o=>`<option ${String(o)===String(val)?'selected':''}>${esc(o)}</option>`).join('')}</select></label>`; if(type==='textarea') return `<label class="${wide}">${label}<textarea name="${name}" ${opt===1?'required':''}>${esc(val)}</textarea></label>`; return `<label class="${wide}">${label}<input name="${name}" type="${type}" value="${esc(val)}" ${opt===1?'required':''}></label>`}).join('')}</div>`}
