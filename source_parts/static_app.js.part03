function entityTable(key,c,rows){let headers=c.cols.map(x=>x.replaceAll('_',' ')); headers.push(''); return table(headers,rows.map(r=>[...c.cols.map(col=>{let v=r[col]; if(col==='status'||col==='severity'||col==='confidence'||col==='verification_status'||col==='decision_type') return badge(v); if(col.includes('cost')||col==='funding_authorized') return fmtMoney(v); if(col==='priority_score') return Number(v||0).toFixed(1); if(col==='scope_locked') return v?'Locked':'Open'; return esc(v)}),key==='decisions'?'<span class="subtle">Immutable</span>':`<div class="row-actions"><button class="btn secondary" onclick="editEntity('${key}',${r.id})">Edit</button><button class="btn secondary" onclick="del('${key}',${r.id})">Delete</button></div>`]));}
function editEntity(key,id){editingRecord={key,id}; entityView(key)}
function cancelEdit(){editingRecord=null; render()}
async function del(k,id){if(!confirm('Delete this record? This action is audit logged.')) return; await api(`/api/${k}/${id}`,{method:'DELETE'}); editingRecord=null; render();}

async function trace(){const a=await getActiveAssessment(); if(!a){$('#content').innerHTML='<div class="notice">Create an assessment first.</div>';return} const id=a.id; const d=await api('/api/trace/'+id); let html=`<div class="notice"><strong>${esc(d.assessment.name)}</strong><br>${esc(d.assessment.mission)}</div><div class="card tree"><ul>`; for(const t of d.threats){html+=`<li><span class="trace-node"><strong>Threat:</strong> ${esc(t.name)} · Raw risk ${t.risk_raw}</span><ul>`; for(const s of t.scenarios){html+=`<li><span class="trace-node"><strong>Scenario:</strong> ${esc(s.title)}</span><ul>`; for(const c of s.capabilities){html+=`<li><span class="trace-node"><strong>Capability:</strong> ${esc(c.name)} · Gap ${Number(c.gap).toFixed(1)}</span><ul>`; for(const g of c.gaps){html+=`<li><span class="trace-node"><strong>Gap:</strong> ${esc(g.description)} · ${esc(g.severity)}</span><ul>`; for(const i of g.improvements){html+=`<li><span class="trace-node"><strong>Improvement:</strong> ${esc(i.title)} · ${fmtMoney(i.initial_cost)}</span><ul>`; for(const dec of i.decisions){html+=`<li><span class="trace-node"><strong>Decision:</strong> ${esc(dec.decision_type)} by ${esc(dec.authority)}</span></li>`} html+='</ul></li>'} html+='</ul></li>'} html+='</ul></li>'} html+='</ul></li>'} html+='</ul></li>'} html+='</ul></div>'; $('#content').innerHTML=html;}

async function implementation(){
  const a=await getActiveAssessment(); if(!a){$('#content').innerHTML='<div class="notice">No assessment available.</div>';return}
  const id=a.id; const [items,decisions]=await Promise.all([api('/api/priorities/'+id),api('/api/decisions?assessment_id='+id)]);
  const decisionByImprovement={}; decisions.forEach(d=>{if(d.improvement_id) decisionByImprovement[d.improvement_id]=d});
  const rows=items.map(i=>{const d=decisionByImprovement[i.id]; return [i.id,esc(i.title),badge(i.status),esc(i.owner||''),fmtMoney(i.initial_cost),`<strong>${Number(i.priority_score).toFixed(1)}</strong>`,d?badge(d.decision_type):'<span class="subtle">Pending</span>',d?esc(d.target_completion||''):'']});
  $('#content').innerHTML=`<div class="notice"><strong>Implementation discipline:</strong> when an improvement is marked Complete, THIRA Command automatically opens a reassessment trigger requiring validation of capability performance and residual risk.</div>${table(['ID','Improvement','Status','Owner','Initial Cost','Priority','Decision','Target'],rows)}`;
}
async function reports(){
