  const r=await fetch('/api/evidence-attachments/'+id+'/download',{headers:{'X-Salus-Role':currentRole,'X-Salus-User':currentUser}});
  if(!r.ok) throw new Error(await r.text()); const blob=await r.blob(); const url=URL.createObjectURL(blob); const a=document.createElement('a'); a.href=url; a.download=name||'attachment'; document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
}

async function attachments(){
  const a=await getActiveAssessment(); if(!a){$('#content').innerHTML='<div class="notice">No assessment available.</div>';return} const [evidence,files]=await Promise.all([api('/api/evidence?assessment_id='+a.id),api('/api/evidence_attachments?assessment_id='+a.id)]);
  $('#content').innerHTML=`<div class="split"><div class="card"><div class="section-title"><h2>Attach Evidence File</h2></div><p class="subtle">Prototype limit: 25 MB per file. Each stored file receives a SHA-256 integrity hash and an audit record.</p><form id="attachment-form"><div class="form-grid"><label>Evidence Record<select name="evidence_id" required>${evidence.map(e=>`<option value="${e.id}">#${e.id} ${esc(e.title)}</option>`).join('')}</select></label><label>File<input name="file" type="file" required></label></div><div class="form-actions"><button class="btn">Upload Evidence File</button></div></form></div><div><div class="section-title"><h2>Evidence File Register</h2><span class="subtle">${files.length} files</span></div>${table(['ID','Evidence','File','Type','Size','SHA-256','Uploaded By',''],files.map(f=>[f.id,f.evidence_id,esc(f.original_name),esc(f.content_type),formatBytes(f.size_bytes),`<code>${esc(f.sha256.slice(0,16))}…</code>`,esc(f.uploaded_by),`<button class="btn secondary" onclick="downloadAttachment(${f.id},'${esc(f.original_name).replaceAll("'","\\'")}')">Download</button>`]))}</div></div>`;
  const form=$('#attachment-form'); if(form) form.onsubmit=async e=>{e.preventDefault();const fd=new FormData(e.target);const id=fd.get('evidence_id');fd.delete('evidence_id');await apiForm(`/api/evidence/${id}/attachments`,fd);render();};
}
function formatBytes(v){const n=Number(v||0); if(n<1024)return n+' B'; if(n<1048576)return (n/1024).toFixed(1)+' KB'; return (n/1048576).toFixed(1)+' MB';}

async function governance(){
  const a=await getActiveAssessment(); if(!a){$('#content').innerHTML='<div class="notice">No assessment available.</div>';return}
  const id=a.id;
  const [scopeChanges,events,versions]=await Promise.all([api('/api/scope_changes?assessment_id='+id),api('/api/workflow_events?assessment_id='+id),api('/api/entity_versions?assessment_id='+id)]);
  const states=['Draft','Scope Approved','Evidence Collection','Analysis','SME Review','Salus QA','Client Validation','Findings Finalized','Executive Decisions','Implementation','Validation','Active Monitoring','Reassessment'];
  $('#content').innerHTML=`
    <div class="grid two-col">
      <div class="card"><div class="section-title"><h2>Controlled Workflow</h2></div><p><strong>Current:</strong> ${badge(a.status)} · Assessment v${a.version} · Scope ${a.scope_locked?'Locked':'Open'}</p><form id="transition-form"><label>Move To<select name="to_status">${states.map(x=>`<option ${x===a.status?'selected':''}>${esc(x)}</option>`).join('')}</select></label><label style="margin-top:10px">Reason<textarea name="reason" placeholder="Required for an Assessment Director/System Administrator override."></textarea></label><div class="form-actions"><button class="btn">Record Transition</button></div></form></div>
      <div class="card"><div class="section-title"><h2>Assessment Export</h2></div><p class="subtle">Exports the assessment record, risk analytics, priorities, decisions, reassessment triggers, scope history, workflow history, and revision index as a portable JSON package.</p><button class="btn" onclick="downloadAssessmentExport(${id})">Download Assessment Package</button></div>
    </div>
    <div class="card" style="margin-top:16px"><div class="section-title"><h2>Request Scope / Mission Change</h2></div><p class="subtle">Approved changes increment the assessment version and preserve the locked scope history.</p><form id="scope-form"><input type="hidden" name="assessment_id" value="${id}"><div class="form-grid"><label class="wide">Reason<textarea name="reason" required></textarea></label><label class="wide">New Purpose<textarea name="new_purpose"></textarea></label><label class="wide">New Mission<textarea name="new_mission"></textarea></label><label class="wide">New Scope<textarea name="new_scope"></textarea></label><label class="wide">New Exclusions<textarea name="new_exclusions"></textarea></label><label>Schedule Impact<input name="schedule_impact"></label><label>Cost Impact<input name="cost_impact" type="number" step="0.01" value="0"></label><label class="wide">Assessment Impact<textarea name="assessment_impact"></textarea></label></div><div class="form-actions"><button class="btn">Submit Scope Change</button></div></form></div>
    <div class="section-title"><h2>Scope Change Register</h2></div>${table(['ID','Decision','Reason','Requested By','Approved By','Cost Impact','Created','Actions'],scopeChanges.map(x=>[x.id,badge(x.decision),esc(x.reason),esc(x.requested_by),esc(x.approved_by),fmtMoney(x.cost_impact),esc(x.created_at),x.decision==='Pending'?`<div class="row-actions"><button class="btn" onclick="scopeDecision(${x.id},'Approved')">Approve</button><button class="btn secondary" onclick="scopeDecision(${x.id},'Rejected')">Reject</button></div>`:'']))}
    <div class="section-title"><h2>Workflow History</h2></div>${table(['Time','From','To','Changed By','Reason'],events.map(x=>[esc(x.created_at),badge(x.from_status),badge(x.to_status),esc(x.changed_by),esc(x.reason)]))}
    <div class="section-title"><h2>Revision History</h2></div>${table(['Time','Entity','Record','Revision','Changed By','Reason'],versions.slice(0,100).map(x=>[esc(x.created_at),esc(x.entity_type),x.entity_id,'v'+x.version_no,esc(x.changed_by),esc(x.change_reason)]))}`;
  $('#transition-form').onsubmit=async e=>{e.preventDefault();const d={};new FormData(e.target).forEach((v,k)=>d[k]=v);await api(`/api/assessments/${id}/transition`,{method:'POST',body:JSON.stringify(d)});render();};
  $('#scope-form').onsubmit=async e=>{e.preventDefault();const d={};new FormData(e.target).forEach((v,k)=>{if(v==='')return;d[k]=k==='assessment_id'?Number(v):k==='cost_impact'?Number(v):v});await api('/api/scope-changes',{method:'POST',body:JSON.stringify(d)});render();};
}
async function scopeDecision(id,decision){const reason=prompt(`${decision} scope change — optional decision note:`)||'';await api(`/api/scope-changes/${id}/decision`,{method:'POST',body:JSON.stringify({decision,reason})});render();}

